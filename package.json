{
  "name": "@ycookiey/lint-config",
  "version": "1.0.0",
  "description": "oxlint (main) + ESLint (supplement) shared config. TypeScript, React, Next.js, Strict.",
  "license": "MIT",
  "keywords": [
    "oxlint",
    "oxlint-config",
    "eslint",
    "eslint-config",
    "config",
    "react",
    "nextjs",
    "typescript",
    "ycookiey"
  ],
  "type": "module",
  "exports": {
    "./oxlint": {
      "types": "./oxlint/index.d.ts",
      "default": "./oxlint/index.js"
    },
    "./oxlint/json": "./oxlint/.oxlintrc.json",
    "./eslint": {
      "require": "./eslint/index.cjs",
      "default": "./eslint/index.cjs"
    }
  },
  "files": [
    "oxlint",
    "eslint",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "oxlint": ">=1",
    "eslint": ">=9",
    "typescript": ">=5"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-simple-import-sort": "^12.0.0"
  },
  "scripts": {
    "lint": "npm run lint:oxlint && npm run lint:eslint",
    "lint:oxlint": "oxlint",
    "lint:eslint": "eslint ."
  },
  "publishConfig": {
    "access": "public"
  }
}
