{
  "name": "@ycookiey/lint-config",
  "version": "2.0.0",
  "description": "oxlint (main) + ESLint (supplement) shared config. TypeScript, React. Next.js 用は ./oxlint/next を追加で読み込む。",
  "license": "MIT",
  "keywords": [
    "oxlint",
    "oxlint-config",
    "eslint",
    "eslint-config",
    "config",
    "react",
    "nextjs",
    "typescript",
    "ycookiey"
  ],
  "type": "module",
  "exports": {
    "./oxlint": {
      "types": "./oxlint/index.d.ts",
      "default": "./oxlint/index.js"
    },
    "./oxlint/json": "./oxlint/.oxlintrc.json",
    "./oxlint/next": {
      "types": "./oxlint/next/index.d.ts",
      "default": "./oxlint/next/index.js"
    },
    "./oxlint/next/json": "./oxlint/next/.oxlintrc.json",
    "./eslint": {
      "require": "./eslint/index.cjs",
      "default": "./eslint/index.cjs"
    },
    "./eslint-strict": {
      "require": "./eslint-strict/index.cjs",
      "default": "./eslint-strict/index.cjs"
    }
  },
  "files": [
    "oxlint",
    "eslint",
    "eslint-strict",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "oxlint": ">=1.85.0",
    "eslint": ">=10",
    "typescript": ">=5"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "oxlint": "^1.85.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "lint": "npm run lint:oxlint && npm run lint:eslint",
    "lint:oxlint": "oxlint",
    "lint:eslint": "eslint ."
  },
  "publishConfig": {
    "access": "public"
  }
}
