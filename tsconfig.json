{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["eslint/**/*.cjs", "eslint-strict/**/*.cjs", "eslint.config.cjs"],
  "exclude": ["node_modules"]
}
